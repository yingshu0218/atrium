{
  "name": "workbench-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:server": "tsc -b apps/server",
    "build:web": "pnpm --filter @workbench/web build",
    "build:mcp": "tsc -b apps/mcp",
    "start:server": "node apps/server/dist/index.js",
    "start:mcp": "node apps/mcp/dist/index.js"
  }
}
