# 复制为 .env 并填写(部署信息,不得写入源码)
ATRIUM_DB_PATH=./data/workbench.sqlite
ATRIUM_PASSWORD=change-me-strong-password
ATRIUM_ADMIN_PASSWORD=change-me-strong-admin-password
# HTTPS 反向代理(如 Caddy)后必须为 true
ATRIUM_COOKIE_SECURE=false
ATRIUM_MIRROR_WORKDIR=./.data-mirror
PORT=3000
# Agent 通道(MCP 进程)
# server-host 必须配置相同值的 agentTokenHash(部署时用此值生成哈希)
ATRIUM_AGENT_TOKEN=change-me-agent-token
ATRIUM_SERVER_URL=http://127.0.0.1:3000
ATRIUM_MCP_PROFILE_ID=default
